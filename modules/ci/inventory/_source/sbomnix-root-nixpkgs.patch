+def _get_flake_nixpkgs_obj(meta_json):
+    """Resolve the root nixpkgs input, including root-relative follows paths."""
+    try:
+        locks = meta_json["locks"]
+        nodes = locks["nodes"]
+        root = locks["root"]
+        if not isinstance(nodes, dict) or not isinstance(root, str):
+            raise ValueError("Malformed flake lock graph")
+
+        def resolve(node_id, input_name, visited):
+            edge = (node_id, input_name)
+            if edge in visited:
+                raise ValueError("Cyclic nixpkgs follows path")
+            visited = visited | {edge}
+            node = nodes[node_id]
+            reference = node["inputs"][input_name]
+            if isinstance(reference, str) and reference:
+                if reference not in nodes or not isinstance(nodes[reference], dict):
+                    raise ValueError("Missing nixpkgs lock node")
+                return reference
+            if isinstance(reference, list) and reference:
+                current = root
+                for name in reference:
+                    if not isinstance(name, str) or not name:
+                        raise ValueError("Malformed nixpkgs follows path")
+                    current = resolve(current, name, visited)
+                return current
+            raise ValueError("Malformed nixpkgs lock reference")
+
+        nixpkgs_node = nodes[resolve(root, "nixpkgs", set())]
+        locked = nixpkgs_node["locked"]
+        if not isinstance(locked, dict) or not locked:
+            raise ValueError("Missing locked root nixpkgs metadata")
+        return locked
+    except (KeyError, TypeError, RecursionError) as error:
+        raise ValueError("Malformed root nixpkgs lock graph") from error
+
